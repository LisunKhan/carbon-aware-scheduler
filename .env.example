# Open Electricity API (optional for live mode)
# Get a key at: https://platform.openelectricity.org.au/
OPENELECTRICITY_API_KEY=

# Use mock carbon data when no API key is set (default: true)
CARBON_MODE=mock

# Redis
REDIS_URL=redis://redis:6379/0

# Poll interval (seconds)
POLL_INTERVAL_SECONDS=300

# Default scheduling threshold (gCO2/kWh). Typical VIC daytime ~200-400, evening peak higher.
CARBON_THRESHOLD_G_PER_KWH=400
